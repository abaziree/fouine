type token =
    UNDERSCORE
  | TIMES
  | THEN
  | SEMISEMI
  | SEMI
  | RPAREN
  | REF
  | REC
  | PRINT
  | PLUS
  | OR
  | NOT
  | NEQ
  | MODULO
  | MINUS
  | LPAREN
  | LET
  | LESS_EQ
  | LESS
  | INT of int
  | IN
  | IF
  | IDENT of string
  | GREATER_EQ
  | GREATER
  | FUN
  | EQ
  | EOF
  | END
  | ELSE
  | DIVIDE
  | DEREF
  | BOOL of bool
  | BEGIN
  | ASSIGN
  | ARROW
  | AND
val menhir_begin_marker : int
val xv_top_expression : Expressions.expr
val xv_simple_expr : Expressions.expr
val xv_nonempty_list_binding_ : string list
val xv_main : Expressions.expr
val xv_expression : Expressions.expr
val xv_binding : string
val xv_application : Expressions.expr
val menhir_end_marker : int
